# Application
APP_NAME=Dendrer
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://dendrer:dendrer@localhost:5432/dendrer
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Stripe (Optional - add when ready)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Inference
VLLM_ENDPOINT=http://localhost:8001
DEFAULT_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Quotas (tokens per month)
FREE_TIER_QUOTA=10000          # $0 - Trial/testing
STARTER_TIER_QUOTA=100000      # $29 - Dev sandbox
PRO_TIER_QUOTA=1000000         # $99 - Production apps
BUSINESS_TIER_QUOTA=10000000   # $399 - Dedicated GPU slice
